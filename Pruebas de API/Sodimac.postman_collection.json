      "name": "RSE",
      "item": [
        {
          "name": "Formular iniciativa RSE",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: una iniciativa de reciclaje que requiere presupuesto"
              ] }
