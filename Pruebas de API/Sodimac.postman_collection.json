              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: se formula la iniciativa (201) con codigo y estado FORMULADA",
                "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                "var j = pm.response.json();",
                "pm.test('Tiene codigo', function () { pm.expect(j).to.have.property('codigo'); pm.collectionVariables.set('rse_codigo', j.codigo); });",
                "pm.test('Estado FORMULADA', function () { pm.expect(j.estado).to.eql('FORMULADA'); });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Reciclaje CD Lima\",\n  \"tipo\": \"RECICLAJE\",\n  \"requierePresupuesto\": true,\n  \"presupuestoSolicitado\": 5000\n}" },
            "url": { "raw": "{{project_host}}/api/iniciativas", "host": [ "{{project_host}}" ], "path": [ "api", "iniciativas" ] }
          }
        },
        {
          "name": "Evaluar iniciativa (comite)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [ "// GIVEN: una iniciativa FORMULADA que requiere presupuesto (rse_codigo)" ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "// THEN: se aprueba (200) y el estado pasa a APROBADA",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var j = pm.response.json();",
              "pm.test('Estado APROBADA', function () { pm.expect(j.estado).to.eql('APROBADA'); });",
              "pm.test('Presupuesto aprobado > 0', function () { pm.expect(j.presupuestoAprobado).to.be.above(0); });"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"aprobada\": true,\n  \"presupuestoAprobado\": 4000\n}" },
            "url": { "raw": "{{project_host}}/api/iniciativas/{{rse_codigo}}/evaluacion", "host": [ "{{project_host}}" ], "path": [ "api", "iniciativas", "{{rse_codigo}}", "evaluacion" ] }
          }
        },
