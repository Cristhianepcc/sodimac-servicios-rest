{
  "info": {
    "name": "Sodimac - Servicios REST (BDD)",
    "description": "Pruebas de aceptacion (API) del Lab 7. Una carpeta por proceso de negocio. Cada request sigue el enfoque BDD: GIVEN (Pre-request), WHEN (Send), THEN (Post-response / Tests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "project_host", "value": "http://localhost:5000" },
    { "key": "ventas_carrito_id", "value": "" },
    { "key": "proveedor_id", "value": "" },
    { "key": "rse_codigo", "value": "" }
