{
  "info": {
    "name": "Sodimac - Servicios REST (BDD)",
    "description": "Pruebas de aceptacion (API) del Lab 7. Una carpeta por proceso de negocio. Cada request sigue el enfoque BDD: GIVEN (Pre-request), WHEN (Send), THEN (Post-response / Tests). Los 5 requests de referencia deben PASAR; los servicios en stub responderan 501 hasta que cada integrante los implemente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "project_host", "value": "http://localhost:5000" },
    { "key": "ventas_carrito_id", "value": "" }
  ],
  "item": [
    {
      "name": "Ventas (Omnicanal)",
      "item": [
        {
          "name": "Crear carrito",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: el endpoint de creacion de carrito y un cliente con un item"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: se crea el carrito (201) con id y total calculado",
                "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                "var j = pm.response.json();",
                "pm.test('Tiene id de carrito', function () {",
                "  pm.expect(j).to.have.property('id');",
                "  pm.collectionVariables.set('ventas_carrito_id', j.id);",
                "});",
                "pm.test('Total = 100', function () { pm.expect(j.total).to.eql(100); });",
                "pm.test('Response time < 5s', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"cliente\": \"C-1\",\n  \"items\": [ { \"sku\": \"SKU1\", \"cantidad\": 2, \"precio_unitario\": 50 } ]\n}" },
            "url": { "raw": "{{project_host}}/api/ventas/carrito", "host": [ "{{project_host}}" ], "path": [ "api", "ventas", "carrito" ] }
          }
        },
        {
          "name": "Consultar carrito",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: un carrito creado previamente (ventas_carrito_id)"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: devuelve el carrito (200) con el mismo id",
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Id coincide', function () {",
                "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('ventas_carrito_id'));",
                "});"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{project_host}}/api/ventas/carrito/{{ventas_carrito_id}}", "host": [ "{{project_host}}" ], "path": [ "api", "ventas", "carrito", "{{ventas_carrito_id}}" ] }
          }
        }
      ]
    },
    {
      "name": "Reabastecimiento",
      "item": [
        {
          "name": "Registrar producto (Inventario)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: un producto con stock por debajo del minimo"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: se registra el producto (201) y queda marcado bajo stock",
                "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                "var j = pm.response.json();",
                "pm.test('SKU correcto', function () { pm.expect(j.sku).to.eql('SKU1'); });",
                "pm.test('bajoStock = true', function () { pm.expect(j.bajoStock).to.be.true; });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"SKU1\",\n  \"nombre\": \"Taladro\",\n  \"stock\": 3,\n  \"stockMinimo\": 5\n}" },
            "url": { "raw": "{{project_host}}/api/inventario", "host": [ "{{project_host}}" ], "path": [ "api", "inventario" ] }
          }
        },
        {
          "name": "Listar bajo stock",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: devuelve la lista (200) con al menos un producto",
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Lista no vacia', function () { pm.expect(pm.response.json().length).to.be.above(0); });"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{project_host}}/api/inventario/bajo-stock", "host": [ "{{project_host}}" ], "path": [ "api", "inventario", "bajo-stock" ] }
          }
        },
        {
          "name": "Listar proveedores (STUB 501)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN (esperado hasta implementar): 501 Not Implemented",
                "pm.test('Status code is 501 (pendiente)', function () { pm.response.to.have.status(501); });"
              ] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{project_host}}/api/proveedores", "host": [ "{{project_host}}" ], "path": [ "api", "proveedores" ] }
          }
        }
      ]
    },
    {
      "name": "Servicios al Cliente",
      "item": [
        {
          "name": "Crear solicitud de servicio",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: un cliente que solicita un servicio de instalacion"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: se registra la solicitud (201) en estado REGISTRADA",
                "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                "var j = pm.response.json();",
                "pm.test('Tiene id', function () { pm.expect(j).to.have.property('id'); });",
                "pm.test('Estado REGISTRADA', function () { pm.expect(j.estado).to.eql('REGISTRADA'); });",
                "pm.collectionVariables.set('servicios_cliente_solicitud_id', j.id);"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"cliente\": \"C-2\",\n  \"tipoServicio\": \"Instalacion de pisos\",\n  \"direccion\": \"Av Siempre Viva 123\"\n}" },
            "url": { "raw": "{{project_host}}/api/solicitudes", "host": [ "{{project_host}}" ], "path": [ "api", "solicitudes" ] }
          }
        },
        {
          "name": "Programar solicitud",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: una solicitud registrada"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: el estado es PROGRAMADA",
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "var j = pm.response.json();",
                "pm.test('Estado PROGRAMADA', function () { pm.expect(j.estado).to.eql('PROGRAMADA'); });",
                "pm.test('Técnico asignado', function () { pm.expect(j.tecnico).to.eql('T-01'); });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"tecnico\": \"T-01\",\n  \"fecha\": \"2026-08-01\"\n}" },
            "url": { "raw": "{{project_host}}/api/solicitudes/{{servicios_cliente_solicitud_id}}/programacion", "host": [ "{{project_host}}" ], "path": [ "api", "solicitudes", "{{servicios_cliente_solicitud_id}}", "programacion" ] }
          }
        },
        {
          "name": "Registrar ejecucion",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: una solicitud programada"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: el estado es EJECUTADA",
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "var j = pm.response.json();",
                "pm.test('Estado EJECUTADA', function () { pm.expect(j.estado).to.eql('EJECUTADA'); });",
                "pm.test('Foto de evidencia guardada', function () { pm.expect(j.evidenciaFotoUrl).to.not.be.null; });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Trabajo completado\",\n  \"fotoUrl\": \"https://sodimac.com/evidencias/SOL-1.jpg\"\n}" },
            "url": { "raw": "{{project_host}}/api/solicitudes/{{servicios_cliente_solicitud_id}}/ejecucion", "host": [ "{{project_host}}" ], "path": [ "api", "solicitudes", "{{servicios_cliente_solicitud_id}}", "ejecucion" ] }
          }
        },
        {
          "name": "Evaluar conformidad",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: una solicitud ejecutada"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: el estado es CONFORME",
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "var j = pm.response.json();",
                "pm.test('Estado CONFORME', function () { pm.expect(j.estado).to.eql('CONFORME'); });",
                "pm.test('Conformidad aprobada', function () { pm.expect(j.conformidadAprobado).to.be.true; });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"aprobado\": true,\n  \"observacion\": \"Servicio excelente\"\n}" },
            "url": { "raw": "{{project_host}}/api/solicitudes/{{servicios_cliente_solicitud_id}}/conformidad", "host": [ "{{project_host}}" ], "path": [ "api", "solicitudes", "{{servicios_cliente_solicitud_id}}", "conformidad" ] }
          }
        },
        {
          "name": "Generar facturacion",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: una solicitud conforme"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: el comprobante se genera y se mantiene el estado CONFORME",
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "var j = pm.response.json();",
                "pm.test('Comprobante emitido', function () { pm.expect(j.comprobante).to.eql('FACT-001'); });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"comprobante\": \"FACT-001\"\n}" },
            "url": { "raw": "{{project_host}}/api/solicitudes/{{servicios_cliente_solicitud_id}}/facturacion", "host": [ "{{project_host}}" ], "path": [ "api", "solicitudes", "{{servicios_cliente_solicitud_id}}", "facturacion" ] }
          }
        }
      ]
    },
    {
      "name": "Postventa",
      "item": [
        {
          "name": "Registrar reclamo",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: un cliente con un reclamo por falla de producto"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: se registra el reclamo (201) en estado REGISTRADO",
                "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                "var j = pm.response.json();",
                "pm.test('Tiene id', function () { pm.expect(j).to.have.property('id'); });",
                "pm.test('Estado REGISTRADO', function () { pm.expect(j.estado).to.eql('REGISTRADO'); });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"cliente\": \"C-3\",\n  \"producto\": \"Cortadora\",\n  \"motivo\": \"Falla de motor\"\n}" },
            "url": { "raw": "{{project_host}}/api/reclamos", "host": [ "{{project_host}}" ], "path": [ "api", "reclamos" ] }
          }
        }
      ]
    },
    {
      "name": "RSE",
      "item": [
        {
          "name": "Formular iniciativa RSE",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// GIVEN: una iniciativa de reciclaje que requiere presupuesto"
              ] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// THEN: se formula la iniciativa (201) con codigo y estado FORMULADA",
                "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                "var j = pm.response.json();",
                "pm.test('Tiene codigo', function () { pm.expect(j).to.have.property('codigo'); });",
                "pm.test('Estado FORMULADA', function () { pm.expect(j.estado).to.eql('FORMULADA'); });"
              ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Reciclaje CD Lima\",\n  \"tipo\": \"RECICLAJE\",\n  \"requierePresupuesto\": true,\n  \"presupuestoSolicitado\": 5000\n}" },
            "url": { "raw": "{{project_host}}/api/iniciativas", "host": [ "{{project_host}}" ], "path": [ "api", "iniciativas" ] }
          }
        }
      ]
    }
  ]
}
