# Copiar a .env y ajustar segun el entorno.

# Backend de persistencia: memoria (doble de prueba) | sqlalchemy (PostgreSQL)
REPO_BACKEND=memoria

# Conexion PostgreSQL (coincide con docker-compose.yml). Usada si REPO_BACKEND=sqlalchemy
DATABASE_URL=postgresql+psycopg://sodimac:sodimac@localhost:5433/reabastecimiento

# Crea las tablas al iniciar (desarrollo)
AUTO_CREATE_TABLES=true

# Servidor
HOST=0.0.0.0
PORT=5000
DEBUG=true

# --- Mensajeria asincrona (integracion con los procesos BPM de Bonita) ---
# memoria (doble de prueba) | rabbitmq (broker real, requerido por worker.py)
# OJO: run.py y worker.py son procesos distintos. Para la demo AMBOS necesitan
# REPO_BACKEND=sqlalchemy, o no comparten estado y la API responde 404.
EVENTOS_BACKEND=memoria

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Colas compartidas con Bonita (mismos nombres que en el repo BPM)
COLA_CONVOCATORIAS=rse.convocatorias
COLA_POSTULACIONES=rse.postulaciones
COLA_NOTIFICACIONES=rse.notificaciones
